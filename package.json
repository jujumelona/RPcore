    "llama.rn": "0.11.5",
    "lottie-react-native": "^7.3.6",
    "lucide-react-native": "^0.577.0",
    "nanoid": "^3.3.11",
    "promise": "8.3.0",
    "react": "^19.2.0",
    "react-i18next": "^17.0.2",
    "react-native": "^0.83.2",
    "react-native-config": "^1.6.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-edge-to-edge": "^1.1.0",
    "react-native-executorch": "^0.7.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-google-mobile-ads": "^16.0.3",
    "react-native-highlight-text": "^0.2.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "^1.21.2",
    "react-native-localize": "^3.7.0",
    "react-native-mmkv": "^4.2.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-pell-rich-editor": "^1.10.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-syntax-highlighter": "^2.1.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.8.1",
    "react-syntax-highlighter": "^16.1.1",
    "zod": "^3.24.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native/eslint-config": "^0.84.1",
    "@react-native/typescript-config": "^0.83.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "dependency-cruiser": "^17.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.13",
    "patch-package": "^8.0.1",
    "react-native-bundle-visualizer": "^3.1.3",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "^3.24.4",
    "promise": "8.3.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "@shopify/react-native-skia",
        "react-native-keyboard-controller",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets",
        "react",
        "react-native-svg"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fs",
          "@amplitude/analytics-react-native",
          "react-native-vector-icons"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
