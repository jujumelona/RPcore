{
  "name": "rp-core",
  "version": "1.0.0",
  "scripts": {
    "android": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-dev-client.ps1",
    "android:dev-client": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-dev-client.ps1",
    "android:testlab": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-testlab-build.ps1",
    "prebuild": "expo prebuild --platform android",
    "start": "npm run metro:reset && set REACT_NATIVE_PACKAGER_HOSTNAME=localhost && expo start --dev-client --localhost --clear",
    "typecheck": "npx tsc --noEmit",
    "i18n:locales": "node scripts/validate-locales-runtime.js",
    "i18n:locales:json": "node scripts/validate-locales-runtime.js --json",
    "i18n:hardcoded": "node scripts/check-hardcoded-ui.js",
    "i18n:audit": "npm run i18n:locales && npm run i18n:hardcoded",
    "lint": "npx eslint . --ext .ts,.tsx,.js,.jsx --fix --config .eslintrc.js",
    "lint:check": "npx eslint . --ext .ts,.tsx,.js,.jsx --config .eslintrc.js",
    "clean": "cd android && ./gradlew clean && cd ..",
    "postinstall": "node ./scripts/run-patch-package.js",
    "metro:reset": "powershell -ExecutionPolicy Bypass -File .\\scripts\\metro-reset.ps1",
    "dev-client:connect": "powershell -ExecutionPolicy Bypass -File .\\scripts\\dev-client-connect.ps1",
    "admin:web:dev": "npm --prefix admin-web run dev",
    "admin:web:build": "npm --prefix admin-web run build",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:kv:structure": "jest --config jest.config.js __tests__/unit/KVPromptLayers.test.ts __tests__/unit/KVCompletionPayload.test.ts __tests__/unit/KVFlowDiagnostics.test.ts __tests__/unit/KVOffsetTrackerLogic.test.ts __tests__/unit/KVHarnessMatrix.test.ts __tests__/unit/KVReplayHarness.test.ts __tests__/unit/KVTurnReuseHarness.test.ts __tests__/unit/KVUserNameStabilityCache.test.ts __tests__/unit/LanguageRuntimeControls.test.ts __tests__/unit/KVSessionMeasurement.test.ts __tests__/unit/LogitBiasNormalizer.test.ts --runInBand",
    "test:kv:harness": "jest --config jest.config.js __tests__/unit/KVHarnessMatrix.test.ts --runInBand",
    "test:kv:replay": "jest --config jest.config.js __tests__/unit/KVReplayHarness.test.ts --runInBand",
    "test:kv:turns": "jest --config jest.config.js __tests__/unit/KVTurnReuseHarness.test.ts --runInBand",
    "test:kv": "jest --config jest.config.js --testPathPattern=KVCacheManager",
    "test:store": "jest --config jest.config.js --testPathPattern=chatStore"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.40",
    "@epubjs-react-native/core": "^1.4.7",
    "@epubjs-react-native/expo-file-system": "^1.1.4",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@kesha-antonov/react-native-background-downloader": "^3.1.0",
    "@legendapp/list": "^2.0.19",
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^15.2.5",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "^21.14.0",
    "@react-native-firebase/messaging": "^21.14.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/metro-config": "^0.83.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@sentry/react-native": "~7.11.0",
