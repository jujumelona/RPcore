    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "6.0.116",
    "events": "^3.3.0",
    "expo": "~55.0.11",
    "expo-asset": "~55.0.12",
    "expo-blur": "~55.0.12",
    "expo-constants": "~55.0.11",
    "expo-crypto": "~55.0.12",
    "expo-dev-client": "~55.0.22",
    "expo-file-system": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-image-manipulator": "~55.0.13",
    "expo-linear-gradient": "~55.0.11",
    "expo-navigation-bar": "~55.0.10",
