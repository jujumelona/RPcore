<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.17</domain>
    </domain-config>
    <!-- Amplitude HTTPS 허용 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api2.amplitude.com</domain>
        <domain includeSubdomains="true">api.amplitude.com</domain>
        <domain includeSubdomains="true">r2.dev</domain>
    </domain-config>
</network-security-config>
